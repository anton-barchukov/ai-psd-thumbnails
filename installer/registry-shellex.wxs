<?xml version="1.0" encoding="utf-8"?>
<!--
  Registry declarations for the ai-psd-thumbnails shell extension.

  CLSID-A (thumbnail provider):  {90E3822E-5F70-40BF-884E-77544797AD41}
  CLSID-B (preview handler):     {2CFC1F9E-0B23-48C3-AE46-29025209D0D4}
  Thumbnail ShellEx key GUID:    {e357fccd-a995-4576-b01f-234630154e96}
  Preview ShellEx key GUID:      {8895b1c6-b41f-4c1c-a562-0d564250836f}
  AppID surrogate (OS-owned):    {6d2b5079-2f0b-48dd-ab7f-97cec514d30b}

  Rules enforced here:
  - Register ONLY under HKCR\SystemFileAssociations\.<ext>\... (association-neutral).
    NEVER touch HKCR\.<ext> default value (ProgID/OpenWith).
  - ThreadingModel=Apartment for BOTH CLSIDs.
  - AppID value set ON CLSID-B key only — the shared OS-owned
    HKCR\AppID\{6d2b5079-...} key is NEVER authored or deleted here.
    Windows pre-registers it with DllSurrogate=prevhost.exe; creating or
    uninstall-deleting it would break every preview handler machine-wide.
  - Per-machine (HKLM) install: WiX maps Root="HKCR" to HKLM\SOFTWARE\Classes
    for per-machine packages, providing clean rollback on uninstall.
  - Uninstall removes ONLY the components listed here (our own keys).
    The shared AppID key and all ProgID associations are left untouched.
  - Formats: .ai .psd .psb .eps .svg (thumbnail + preview each) plus .pdf
    (thumbnail ONLY — Explorer has no built-in .pdf thumbnail provider, but its
    preview pane is already owned by the OS/Edge handler, so no .pdf preview row).
  - PreviewHandlers HKLM named value: required for the preview pane to enumerate
    our handler in the "preview handlers" list.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ── CLSID-A InprocServer32 (thumbnail provider) ──────────────────────────

       HKCR\CLSID\{90E3822E-5F70-40BF-884E-77544797AD41}\InprocServer32
         (default)      = [INSTALLFOLDER]thumb_viewer.dll
         ThreadingModel = Apartment
  -->
  <Fragment>
    <Component Id="CMP_RegClsidA_InprocServer32"
               Directory="INSTALLFOLDER"
               Guid="34309C66-6A33-4F7B-8649-C2A9F238EC01">
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{90E3822E-5F70-40BF-884E-77544797AD41}\InprocServer32"
          Value="[INSTALLFOLDER]thumb_viewer.dll"
          Type="string"
          KeyPath="yes" />
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{90E3822E-5F70-40BF-884E-77544797AD41}\InprocServer32"
          Name="ThreadingModel"
          Value="Apartment"
          Type="string" />
    </Component>
  </Fragment>

  <!-- ── CLSID-B InprocServer32 (preview handler) ─────────────────────────────

       HKCR\CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}\InprocServer32
         (default)      = [INSTALLFOLDER]thumb_viewer.dll
         ThreadingModel = Apartment
  -->
  <Fragment>
    <Component Id="CMP_RegClsidB_InprocServer32"
               Directory="INSTALLFOLDER"
               Guid="82D51590-9871-40A7-9ACE-0E56EF2173EA">
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}\InprocServer32"
          Value="[INSTALLFOLDER]thumb_viewer.dll"
          Type="string"
          KeyPath="yes" />
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}\InprocServer32"
          Name="ThreadingModel"
          Value="Apartment"
          Type="string" />
    </Component>
  </Fragment>

  <!-- ── CLSID-B AppID value (on the CLSID-B key, NOT the shared AppID key) ───

       HKCR\CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}
         AppID = {6d2b5079-2f0b-48dd-ab7f-97cec514d30b}

       This sets the AppID *named value* on our CLSID key so that COM routes
       the preview handler through prevhost.exe (which already has
       DllSurrogate= set in the OS-owned HKCR\AppID\{6d2b5079-...} key).
       We never touch the AppID key itself.
  -->
  <Fragment>
    <Component Id="CMP_RegClsidB_AppIdValue"
               Directory="INSTALLFOLDER"
               Guid="5D8DF31B-3046-435C-BD3B-33FAC39E2B19">
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Name="AppID"
          Value="{6d2b5079-2f0b-48dd-ab7f-97cec514d30b}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ── CLSID-B display name ──────────────────────────────────────────────────

       HKCR\CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}
         (default) = "ai-psd-thumbnails Preview"
  -->
  <Fragment>
    <Component Id="CMP_RegClsidB_DisplayName"
               Directory="INSTALLFOLDER"
               Guid="9D7DBD66-1407-4FB3-BFCD-A50B95E13630">
      <RegistryValue
          Root="HKCR"
          Key="CLSID\{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Value="ai-psd-thumbnails Preview"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ── Per-extension ShellEx registrations ──────────────────────────────────
       5 extensions × 2 handlers = 10 components.
       Thumbnail handler uses key: {e357fccd-a995-4576-b01f-234630154e96}
       Preview handler uses key:   {8895b1c6-b41f-4c1c-a562-0d564250836f}

       Key structure (thumbnail — uppercase ShellEx):
         HKCR\SystemFileAssociations\.<ext>\ShellEx\{e357fccd-...} = {CLSID-A}

       Key structure (preview — lowercase shellex, matching MS registration mechanics):
         HKCR\SystemFileAssociations\.<ext>\shellex\{8895b1c6-...} = {CLSID-B}

       NEVER author HKCR\.<ext>\ShellEx or HKCR\.<ext> default — those paths are
       where SageThumbs wrote and broke the .ai association.
  -->

  <!-- .ai thumbnail -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Ai_Thumb"
               Directory="INSTALLFOLDER"
               Guid="D5511DB4-C413-4580-87FB-E8885264F56A">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.ai\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .ai preview -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Ai_Preview"
               Directory="INSTALLFOLDER"
               Guid="A1A08759-A639-45F1-BD8E-536A76BB9E1E">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.ai\shellex\{8895b1c6-b41f-4c1c-a562-0d564250836f}"
          Value="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .psd thumbnail -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Psd_Thumb"
               Directory="INSTALLFOLDER"
               Guid="0A40C8F6-3326-4807-8F24-0A148A763E9A">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.psd\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .psd preview -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Psd_Preview"
               Directory="INSTALLFOLDER"
               Guid="77603314-DB68-46D4-BE2B-D0C66B70CEB3">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.psd\shellex\{8895b1c6-b41f-4c1c-a562-0d564250836f}"
          Value="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .psb thumbnail -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Psb_Thumb"
               Directory="INSTALLFOLDER"
               Guid="3364CB62-5E7B-409D-8526-CD31EE753448">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.psb\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .psb preview -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Psb_Preview"
               Directory="INSTALLFOLDER"
               Guid="2C404C83-167B-43B3-BB10-738CEC190D81">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.psb\shellex\{8895b1c6-b41f-4c1c-a562-0d564250836f}"
          Value="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .eps thumbnail -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Eps_Thumb"
               Directory="INSTALLFOLDER"
               Guid="9F316648-EAC3-4DED-8768-A5A1C3E38C45">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.eps\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .eps preview -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Eps_Preview"
               Directory="INSTALLFOLDER"
               Guid="9D3C0304-28A2-4460-A75C-0138E56E1E2B">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.eps\shellex\{8895b1c6-b41f-4c1c-a562-0d564250836f}"
          Value="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .svg thumbnail -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Svg_Thumb"
               Directory="INSTALLFOLDER"
               Guid="0F618307-75E3-4AE1-B49A-1B744FC1567F">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.svg\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .svg preview -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Svg_Preview"
               Directory="INSTALLFOLDER"
               Guid="114291E8-BC17-4466-9519-2B9EF031F5AE">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.svg\shellex\{8895b1c6-b41f-4c1c-a562-0d564250836f}"
          Value="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- .pdf thumbnail (thumbnail ONLY — no preview counterpart; see header) -->
  <Fragment>
    <Component Id="CMP_RegShellEx_Pdf_Thumb"
               Directory="INSTALLFOLDER"
               Guid="8D6E2B67-2005-4834-99B4-64AAC4B6FEF7">
      <RegistryValue
          Root="HKCR"
          Key="SystemFileAssociations\.pdf\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
          Value="{90E3822E-5F70-40BF-884E-77544797AD41}"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ── PreviewHandlers registration ─────────────────────────────────────────

       HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\PreviewHandlers
         {2CFC1F9E-0B23-48C3-AE46-29025209D0D4} = "ai-psd-thumbnails Preview"

       This named value makes the preview handler discoverable by the shell's
       preview handler enumeration logic.
  -->
  <Fragment>
    <Component Id="CMP_RegPreviewHandlers"
               Directory="INSTALLFOLDER"
               Guid="108EFF84-DE66-4DF6-BB84-29CD7287F944">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\PreviewHandlers"
          Name="{2CFC1F9E-0B23-48C3-AE46-29025209D0D4}"
          Value="ai-psd-thumbnails Preview"
          Type="string"
          KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
